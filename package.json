{
  "name": "aura-life-dashboard",
  "version": "1.1.0",
  "description": "PWA académica offline-first: notas, tareas, calendario, voz + IA (Gemini) y sync CouchDB.",
  "private": true,
  "scripts": {
    "start": "http-server -p 8080 -c-1 --silent",
    "serve": "python -m http.server 8080 --bind 127.0.0.1",
    "start:node": "http-server -p 8080 -c-1 --silent",
    "start:py": "python -m http.server 8080 --bind 127.0.0.1"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
